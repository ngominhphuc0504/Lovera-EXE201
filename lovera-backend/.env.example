POSTGRES_DB=lovera
POSTGRES_USER=lovera
POSTGRES_HOST_PORT=5434
POSTGRES_PASSWORD=replace-with-your-local-password
OTP_PEPPER=replace-with-at-least-32-random-characters

ALLOW_PUBLIC_REGISTRATION=true
PAIRING_CODE_HOURS=24
TIME_ZONE_ID=Asia/Ho_Chi_Minh

AI_CHAT_COMPLETIONS_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=15

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mailpit is used by default for local testing.
SMTP_FROM=no-reply@lovera.local

# For real email, put these values in your private .env file instead:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENABLE_SSL=true
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-app-password