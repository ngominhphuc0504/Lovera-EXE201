POSTGRES_DB=lovera
POSTGRES_USER=lovera
POSTGRES_HOST_PORT=5434
POSTGRES_PASSWORD=replace-with-your-local-password
OTP_PEPPER=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
SMTP_FROM=no-reply@lovera.local
# Development uses Mailpit by default. For real SMTP, set the following in your private .env:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENABLE_SSL=true
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-secret
